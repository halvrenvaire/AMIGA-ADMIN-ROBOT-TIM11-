{
  "name": "amiga-robot-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter backend test:e2e",
    "test:cypress": "pnpm --filter frontend cypress:run",
    "test:cypress:open": "pnpm --filter frontend cypress:open",
    "typecheck": "turbo run typecheck",
    "db:migrate": "pnpm --filter backend db:migrate",
    "db:seed": "pnpm --filter backend db:seed",
    "db:studio": "pnpm --filter backend db:studio"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@10.13.1"
}
