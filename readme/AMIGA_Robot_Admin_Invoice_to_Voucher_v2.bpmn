<bpmn:sequenceFlow id="F15" name="Duplikat / struk / perlu cek manual" sourceRef="G7" targetRef="T13"/>
<bpmn:sequenceFlow id="F16" sourceRef="T13" targetRef="G8"/>
<bpmn:sequenceFlow id="F17" name="Lanjut ditinjau" sourceRef="G8" targetRef="T7"/>
<bpmn:sequenceFlow id="F18" name="Ditolak / dikembalikan" sourceRef="G8" targetRef="G5"/>
<bpmn:sequenceFlow id="F19" sourceRef="T7" targetRef="G3"/>
<bpmn:sequenceFlow id="F20" name="Kembalikan ke PIC (wajib alasan)" sourceRef="G3" targetRef="T5"/>
<bpmn:sequenceFlow id="F21" name="Setujui" sourceRef="G3" targetRef="T8"/>
<bpmn:sequenceFlow id="F22" sourceRef="T8" targetRef="G4"/>
<bpmn:sequenceFlow id="F23" name="Ya" sourceRef="G4" targetRef="T9"/>
<bpmn:sequenceFlow id="F24" name="Tinjau ulang oleh reviewer lain" sourceRef="T9" targetRef="T7"/>
<bpmn:sequenceFlow id="F25" name="Tidak" sourceRef="G4" targetRef="T11"/>
<bpmn:sequenceFlow id="F26" sourceRef="T11" targetRef="T12"/>
<bpmn:sequenceFlow id="F27" sourceRef="T12" targetRef="E1"/>
<bpmn:sequenceFlow id="F28" sourceRef="S2" targetRef="T10"/>
<bpmn:sequenceFlow id="F29" sourceRef="T10" targetRef="E2"/>
<bpmn:dataStoreReference id="DS1" name="Jejak Audit (permanen)"/>
<bpmn:textAnnotation id="TA1"><bpmn:text>Setiap aktivitas, perubahan data (nilai awal → nilai baru), pengembalian, penolakan SoD, pengalihan, dan pembatalan dicatat permanen; tidak bisa diubah/dihapus siapa pun.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="A1" sourceRef="DS1" targetRef="TA1"/>
<bpmn:textAnnotation id="TA2"><bpmn:text>Saluran: dashboard web atau bot Telegram @amiga_ro_bot. Foto JPG/PNG/WEBP diubah otomatis menjadi PDF; foto asli disimpan.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="A2" sourceRef="T1" targetRef="TA2"/>
<bpmn:textAnnotation id="TA3"><bpmn:text>Bila jumlah rincian ≠ total, AI membaca ulang khusus baris PPN/biaya/potongan; dipakai hanya bila hitungan menjadi pas.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="A3" sourceRef="T3" targetRef="TA3"/>
</bpmn:process>
