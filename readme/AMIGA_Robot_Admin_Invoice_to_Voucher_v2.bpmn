<bpmn:startEvent id="S1" name="Invoice vendor diterima">
<bpmn:outgoing>F1</bpmn:outgoing>
</bpmn:startEvent>
<bpmn:userTask id="T1" name="Unggah 1–10 invoice (PDF / foto) &amp; isi formulir">
<bpmn:incoming>F1</bpmn:incoming>
<bpmn:incoming>F4</bpmn:incoming>
<bpmn:outgoing>F2</bpmn:outgoing>
</bpmn:userTask>
<bpmn:exclusiveGateway id="G1" name="File valid?">
<bpmn:incoming>F2</bpmn:incoming>
<bpmn:outgoing>F3</bpmn:outgoing>
<bpmn:outgoing>F4</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="T2" name="Foto → PDF, terbitkan Request ID (QUEUED), tugaskan reviewer">
<bpmn:incoming>F3</bpmn:incoming>
<bpmn:outgoing>F5</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="T3" name="Klasifikasi dokumen &amp; ekstraksi data (PROCESSING)">
<bpmn:incoming>F5</bpmn:incoming>
<bpmn:incoming>F13</bpmn:incoming>
<bpmn:outgoing>F6</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:businessRuleTask id="T4" name="Verifikasi kelengkapan, angka &amp; PPN, duplikasi, rekening">
<bpmn:incoming>F6</bpmn:incoming>
<bpmn:outgoing>F7</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="G2" name="Lolos verifikasi?">
<bpmn:incoming>F7</bpmn:incoming>
<bpmn:outgoing>F8</bpmn:outgoing>
<bpmn:outgoing>F14</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="T5" name="Tandai EXCEPTION + kode &amp; alasan">
<bpmn:incoming>F8</bpmn:incoming>
<bpmn:incoming>F20</bpmn:incoming>
<bpmn:outgoing>F9</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="G7" name="Jenis kendala?">
<bpmn:incoming>F9</bpmn:incoming>
<bpmn:outgoing>F10</bpmn:outgoing>
<bpmn:outgoing>F15</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="G5" name="Perbaiki atau batalkan?">
<bpmn:incoming>F10</bpmn:incoming>
<bpmn:incoming>F18</bpmn:incoming>
<bpmn:outgoing>F11</bpmn:outgoing>
<bpmn:outgoing>F12</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:endEvent id="E3" name="Pengajuan dibatalkan (CANCELLED)">
<bpmn:incoming>F12</bpmn:incoming>
</bpmn:endEvent>
<bpmn:userTask id="T6" name="Lengkapi / perbaiki data invoice">
<bpmn:incoming>F11</bpmn:incoming>
<bpmn:outgoing>F13</bpmn:outgoing>
</bpmn:userTask>
<bpmn:userTask id="T7" name="Tinjau &amp; koreksi (split-screen); konfirmasi rekening">
<bpmn:incoming>F14</bpmn:incoming>
<bpmn:incoming>F17</bpmn:incoming>
<bpmn:incoming>F24</bpmn:incoming>
<bpmn:outgoing>F19</bpmn:outgoing>
</bpmn:userTask>
<bpmn:exclusiveGateway id="G3" name="Keputusan reviewer">
<bpmn:incoming>F19</bpmn:incoming>
<bpmn:outgoing>F20</bpmn:outgoing>
<bpmn:outgoing>F21</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:userTask id="T13" name="Putuskan kendala khusus: duplikat / struk / cek manual">
<bpmn:incoming>F15</bpmn:incoming>
<bpmn:outgoing>F16</bpmn:outgoing>
</bpmn:userTask>
<bpmn:exclusiveGateway id="G8" name="Hasil keputusan?">
<bpmn:incoming>F16</bpmn:incoming>
<bpmn:outgoing>F17</bpmn:outgoing>
<bpmn:outgoing>F18</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="T8" name="Cek Segregation of Duties">
<bpmn:incoming>F21</bpmn:incoming>
<bpmn:outgoing>F22</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="G4" name="Penyetuju = pihak pengaju?">
<bpmn:incoming>F22</bpmn:incoming>
<bpmn:outgoing>F23</bpmn:outgoing>
<bpmn:outgoing>F25</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="T9" name="Tolak &amp; alihkan otomatis ke reviewer dengan kasus paling sedikit">
<bpmn:incoming>F23</bpmn:incoming>
<bpmn:outgoing>F24</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="T11" name="AMIGA_REVIEWED: buat voucher PDF (≤ 3 dtk)">
<bpmn:incoming>F25</bpmn:incoming>
<bpmn:outgoing>F26</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:userTask id="T12" name="Unduh voucher PDF (SENT_TO_CLIENT)">
<bpmn:incoming>F26</bpmn:incoming>
<bpmn:outgoing>F27</bpmn:outgoing>
</bpmn:userTask>
<bpmn:endEvent id="E1" name="Voucher diteruskan ke Client Approver">
<bpmn:incoming>F27</bpmn:incoming>
</bpmn:endEvent>
<bpmn:startEvent id="S2" name="Beban reviewer &gt; 5 dokumen tertunda">
<bpmn:outgoing>F28</bpmn:outgoing>
</bpmn:startEvent>
<bpmn:userTask id="T10" name="Alihkan dokumen ke reviewer lain">
<bpmn:incoming>F28</bpmn:incoming>
<bpmn:outgoing>F29</bpmn:outgoing>
</bpmn:userTask>
<bpmn:endEvent id="E2" name="Beban kerja seimbang">
<bpmn:incoming>F29</bpmn:incoming>
</bpmn:endEvent>
<bpmn:sequenceFlow id="F1" sourceRef="S1" targetRef="T1"/>
<bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="G1"/>
<bpmn:sequenceFlow id="F3" name="Ya" sourceRef="G1" targetRef="T2"/>
