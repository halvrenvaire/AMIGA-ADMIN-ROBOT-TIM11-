<bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="L_fin" name="Finance Reviewer">
<bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
<bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="L_lead" name="Service Lead">
<bpmn:flowNodeRef>S2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
<bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="S1" name="Invoice vendor diterima">
<bpmn:outgoing>F1</bpmn:outgoing>
</bpmn:startEvent>
<bpmn:userTask id="T1" name="Unggah invoice PDF &amp; isi formulir">
<bpmn:incoming>F1</bpmn:incoming>
<bpmn:incoming>F4</bpmn:incoming>
<bpmn:outgoing>F2</bpmn:outgoing>
</bpmn:userTask>
<bpmn:exclusiveGateway id="G1" name="File valid?">
<bpmn:incoming>F2</bpmn:incoming>
<bpmn:outgoing>F3</bpmn:outgoing>
<bpmn:outgoing>F4</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="T2" name="Terbitkan Request ID (QUEUED)">
<bpmn:incoming>F3</bpmn:incoming>
<bpmn:outgoing>F5</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="T3" name="Ekstraksi data invoice (PROCESSING)">
<bpmn:incoming>F5</bpmn:incoming>
<bpmn:incoming>F10</bpmn:incoming>
<bpmn:outgoing>F6</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:businessRuleTask id="T4" name="Verifikasi angka, kelengkapan dan duplikasi">
<bpmn:incoming>F6</bpmn:incoming>
<bpmn:outgoing>F7</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="G2" name="Lolos verifikasi?">
<bpmn:incoming>F7</bpmn:incoming>
<bpmn:outgoing>F8</bpmn:outgoing>
<bpmn:outgoing>F11</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="T5" name="Tandai EXCEPTION, tampilkan kode kendala &amp; alasan">
<bpmn:incoming>F8</bpmn:incoming>
<bpmn:outgoing>F9</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:userTask id="T6" name="Lengkapi / perbaiki data invoice">
<bpmn:incoming>F9</bpmn:incoming>
<bpmn:incoming>F13</bpmn:incoming>
<bpmn:outgoing>F10</bpmn:outgoing>
</bpmn:userTask>
<bpmn:userTask id="T7" name="Tinjau &amp; koreksi hasil ekstraksi, perhitungan &amp; kelengkapan">
<bpmn:incoming>F11</bpmn:incoming>
<bpmn:incoming>F17</bpmn:incoming>
<bpmn:outgoing>F12</bpmn:outgoing>
</bpmn:userTask>
<bpmn:exclusiveGateway id="G3" name="Keputusan reviewer">
<bpmn:incoming>F12</bpmn:incoming>
<bpmn:outgoing>F13</bpmn:outgoing>
<bpmn:outgoing>F14</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="T8" name="Cek Segregation of Duties">
<bpmn:incoming>F14</bpmn:incoming>
<bpmn:outgoing>F15</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="G4" name="Penyetuju = pengunggah?">
<bpmn:incoming>F15</bpmn:incoming>
<bpmn:outgoing>F16</bpmn:outgoing>
<bpmn:outgoing>F18</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="T9" name="Tolak persetujuan &amp; alihkan otomatis ke reviewer lain">
<bpmn:incoming>F16</bpmn:incoming>
<bpmn:outgoing>F17</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="T11" name="Set AMIGA_REVIEWED &amp; buat voucher PDF">
<bpmn:incoming>F18</bpmn:incoming>
<bpmn:outgoing>F19</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:userTask id="T12" name="Unduh voucher PDF (SENT_TO_CLIENT)">
<bpmn:incoming>F19</bpmn:incoming>
<bpmn:outgoing>F20</bpmn:outgoing>
</bpmn:userTask>
<bpmn:endEvent id="E1" name="Voucher diteruskan ke Client Approver">
<bpmn:incoming>F20</bpmn:incoming>
</bpmn:endEvent>
<bpmn:startEvent id="S2" name="Beban reviewer terlalu banyak">
<bpmn:outgoing>F21</bpmn:outgoing>
</bpmn:startEvent>
<bpmn:userTask id="T10" name="Atur ulang beban: alihkan dokumen ke reviewer lain">
<bpmn:incoming>F21</bpmn:incoming>
<bpmn:outgoing>F22</bpmn:outgoing>
</bpmn:userTask>
<bpmn:endEvent id="E2" name="Beban kerja seimbang">
<bpmn:incoming>F22</bpmn:incoming>
</bpmn:endEvent>
