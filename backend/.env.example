# Database (PostgreSQL lokal)
DATABASE_URL=postgresql+psycopg://amiga:GANTI_PASSWORD@localhost:5432/amiga_robot_admin

# Auth
# Wajib, minimal 32 karakter acak: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=480

# Penyimpanan file: "local" (folder storage/) atau "s3"
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=../storage

# AWS
AWS_ACCESS_KEY=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=
AWS_REGION=ap-southeast-1
EXTRACTION_MODEL_ID=
# false = AI tidak membaca invoice; setiap unggahan menjadi draf yang diisi PIC secara manual
AI_EXTRACTION_ENABLED=true

# Password semua akun dummy hasil seed.py
SEED_DEFAULT_PASSWORD=

# RAG /ask (opsional; nilai default ada di app/config.py)
# LLM_MODEL=apac.amazon.nova-lite-v1:0
# EMBED_MODEL=amazon.titan-embed-text-v2:0
# EMBED_REGION=us-east-1
# Kunci untuk header X-API-Key pada POST /reindex
REINDEX_API_KEY=

# Bot Telegram (jalankan: .venv/bin/python -m bot.telegram_bot)
# Token dari @BotFather. Jangan dibagikan; siapa pun yang memegang token bisa mengendalikan bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=amiga_ro_bot
# Alamat API AMIGA yang dipanggil bot, dan alamat dashboard untuk tautan di pesan bot
BOT_API_BASE_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:5173
