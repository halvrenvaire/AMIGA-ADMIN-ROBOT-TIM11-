# Database (PostgreSQL 16)
DATABASE_URL="postgresql://postgres:password@localhost:5432/amiga_robot_admin"

# Auth
JWT_SECRET="ganti-dengan-string-acak-panjang-minimum-256-bits-super-secret-amiga"
JWT_EXPIRE_MINUTES=480

# File Storage: "local" (folder storage/) atau "s3"
STORAGE_BACKEND="local"
LOCAL_STORAGE_DIR="../storage"

# Default Password untuk Seeding
SEED_DEFAULT_PASSWORD="password123!"

# AWS Configuration
AWS_ACCESS_KEY="xxx"
AWS_SECRET_ACCESS_KEY="xxx"
AWS_BUCKET="bedrock-kb-xxx-xxx"

# Bedrock Configuration (default models)
AWS_REGION="ap-southeast-1"
BEDROCK_MODEL_ID="amazon.titan-text-express-v1"
EMBEDDING_MODEL_ID="amazon.titan-embed-text-v1"

# Constraints & SLAs
MAX_INVOICE_PAGES=5
WORKLOAD_MAX_THRESHOLD=10
AI_EXTRACTION_TIMEOUT_MS=15000
