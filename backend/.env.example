# Database (PostgreSQL lokal)
DATABASE_URL=postgresql+psycopg://amiga:GANTI_PASSWORD@localhost:5432/amiga_robot_admin

# Auth
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRE_MINUTES=480

# Penyimpanan file: "local" (folder storage/) atau "s3"
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=../storage

# AWS
AWS_ACCESS_KEY=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=
AWS_REGION=ap-southeast-1
EXTRACTION_MODEL_ID=

# Password semua akun dummy hasil seed.py
SEED_DEFAULT_PASSWORD=

# RAG /ask (opsional; nilai default ada di app/config.py)
# LLM_MODEL=apac.amazon.nova-lite-v1:0
# EMBED_MODEL=amazon.titan-embed-text-v2:0
# EMBED_REGION=us-east-1
# Kunci untuk header X-API-Key pada POST /reindex
REINDEX_API_KEY=
